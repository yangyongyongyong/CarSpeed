                android:id="@+id/btnPhotoBatch"
                style="@style/Widget.CarSpeed.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/video_batch_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoDeletePage"
                style="@style/Widget.CarSpeed.Button.Text"
