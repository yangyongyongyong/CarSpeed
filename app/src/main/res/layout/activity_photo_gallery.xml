            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoBatchExit"
                style="@style/Widget.CarSpeed.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/video_batch_exit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoBatchToggleAll"
                style="@style/Widget.CarSpeed.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/video_batch_select_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhotoBatchDeleteSelected"
                style="@style/Widget.CarSpeed.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/video_batch_delete_selected" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPhotoList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
