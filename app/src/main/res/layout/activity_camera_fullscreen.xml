<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.camera.view.PreviewView
        android:id="@+id/fullscreenPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        app:implementationMode="performance" />

    <android.view.TextureView
        android:id="@+id/fullscreenRecordingTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.thomas.carspeed.PlateOverlayView
        android:id="@+id/fullscreenPlateOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvFullscreenTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/overlay_chip_dark_bg"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullscreenRecord"
            style="@style/Widget.CarSpeed.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_start_recording" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullscreenPhoto"
            style="@style/Widget.CarSpeed.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/take_photo_now" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullscreenClose"
            style="@style/Widget.CarSpeed.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/fullscreen_close" />
    </LinearLayout>
    </FrameLayout>

    <com.thomas.carspeed.DashcamInfoBar
        android:id="@+id/tvFullscreenOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
