<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_sand"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/transparent"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="@string/radar_settings_title"
            app:titleTextColor="@color/text_primary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CarSpeed.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvRadarStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/radar_status_off"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <CheckBox
                    android:id="@+id/cbRadarAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_alert_toggle"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvRadarThresholdsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_thresholds_label_default"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRadarThresholds"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/radar_thresholds_edit" />

                <TextView
                    android:id="@+id/tvRadarLeadLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_lead_label_default"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <SeekBar
                    android:id="@+id/sbRadarLeadSeconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="10" />

                <TextView
                    android:id="@+id/tvRadarSpeechRateLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_speech_rate_label_default"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <SeekBar
                    android:id="@+id/sbRadarSpeechRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="220" />

                <CheckBox
                    android:id="@+id/cbPitchRoadLayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_pitch_road_layer"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/radar_pitch_road_layer_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <CheckBox
                    android:id="@+id/cbSatelliteTunnel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_satellite_tunnel"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/radar_satellite_tunnel_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <CheckBox
                    android:id="@+id/cbUnknownRoadElevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_unknown_layer_elevated"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvRoadLayerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/radar_road_layer_default_elevated"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/radar_unknown_layer_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <CheckBox
                    android:id="@+id/cbRoadDivergenceCorrection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_divergence_correction"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/radar_divergence_correction_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/radar_alert_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
