<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_sand"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/transparent"
            app:navigationIcon="@drawable/ic_nav_back"
            app:title="@string/track_settings_title"
            app:titleTextColor="@color/text_primary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CarSpeed.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvTrackStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/track_status_off"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <CheckBox
                    android:id="@+id/cbTrackRecordingEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/track_recording_toggle"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/bluetooth_car_devices_title"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBluetoothDevices"
                    style="@style/Widget.CarSpeed.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/bluetooth_select_devices" />

                <TextView
                    android:id="@+id/tvBluetoothDeviceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/bluetooth_selected_none"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <CheckBox
                    android:id="@+id/cbTrackTriggerBtSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/track_trigger_bt_speed"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cbTrackTriggerBtDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/track_trigger_bt_distance"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/track_recording_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
