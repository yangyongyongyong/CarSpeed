<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_sand"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@android:color/transparent"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="@string/dashcam_settings_title"
            app:titleTextColor="@color/text_primary" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CarSpeed.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/video_mode_label"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <Spinner
                    android:id="@+id/spVideoMode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/surface_secondary" />

                <TextView
                    android:id="@+id/tvLoopStorageLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/loop_storage_label_default"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <SeekBar
                    android:id="@+id/sbLoopStorage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="10" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/loop_storage_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <TextView
                    android:id="@+id/tvSegmentLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/segment_duration_label_default"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <SeekBar
                    android:id="@+id/sbSegmentMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="10"
                    android:progress="5" />

                <CheckBox
                    android:id="@+id/cbParkingStop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/parking_stop_toggle"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvParkingStopLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/parking_stop_label_default"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <SeekBar
                    android:id="@+id/sbParkingStopMinutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="30"
                    android:progress="3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parking_stop_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <TextView
                    android:id="@+id/tvZoomLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/zoom_label_default"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <SeekBar
                    android:id="@+id/sbZoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="10" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/zoom_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <CheckBox
                    android:id="@+id/cbRecordAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/record_audio_toggle"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cbVoicePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/voice_photo_toggle"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cbAutoStartRecording"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/auto_start_recording_toggle"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cbAutoTrigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/auto_trigger_toggle"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/auto_trigger_helper"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/bluetooth_car_devices_title"
                    android:textAppearance="@style/TextAppearance.CarSpeed.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBluetoothDevices"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/bluetooth_select_devices" />

                <TextView
                    android:id="@+id/tvBluetoothDeviceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/bluetooth_selected_none"
                    android:textAppearance="@style/TextAppearance.CarSpeed.Body" />

                <CheckBox
                    android:id="@+id/cbWatermarkTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/watermark_time_toggle"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cbWatermarkSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/watermark_speed_toggle"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cbWatermarkGps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/watermark_gps_toggle"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cbWatermarkAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/watermark_address_toggle"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cbWatermarkVideoMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/watermark_video_mode_toggle"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
